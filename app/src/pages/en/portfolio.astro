---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';
import { getTranslations } from '@/content/i18n/app';

const t = getTranslations('en');
---

<StarlightPage frontmatter={{ title: t.pages.portfolioTitle }}>
  <p>{t.pages.portfolioIntro}</p>

  <AnchorHeading level="2" id="learn-more">{t.pages.portfolioHeading}</AnchorHeading>
  <p>
    <a href="https://starlight.astro.build/">
      {t.pages.portfolioLink}
    </a>
  </p>
</StarlightPage>
