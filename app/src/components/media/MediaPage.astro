---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaApp, { type MediaView } from './MediaApp';
import { getTranslations, type Locale } from '@/content/i18n/app';
import '../../styles/media.css';

interface Props {
  locale: Locale;
  view?: MediaView;
}

const { locale, view = 'library' } = Astro.props;
const t = getTranslations(locale);
const titles: Record<MediaView, string> = {
  library: t.pages.mediaTitle,
  upload: t.media.tabs.upload,
  categories: t.media.tabs.categories,
  presets: t.media.tabs.presets,
  admin: t.media.tabs.admin,
  maintenance: t.media.tabs.maintenance,
};
---

<StarlightPage frontmatter={{
  title: titles[view],
  tableOfContents: false
}}>
  <MediaApp view={view} client:only="react">
    <div slot="fallback" class="w-full space-y-6 py-6 animate-pulse">
      <div class="space-y-2 border-b pb-3 mb-3">
        <div class="h-8 w-48 rounded bg-muted/60"></div>
        <div class="h-4 w-72 rounded bg-muted/40"></div>
      </div>
      <div class="h-64 rounded-xl border bg-muted/20"></div>
    </div>
  </MediaApp>
</StarlightPage>
