# Copy to .env — Docker Compose infrastructure variables.
# Application settings go in auth.env, media.env, prompt.env, and reparto.env
# (see the matching *.example files).
# Generate passwords: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Optional: Traefik port binding ───────────────────────────────────────────
# Default 127.0.0.1 (localhost only). Set to 0.0.0.0 to expose on the LAN.
#API_BIND_IP=127.0.0.1

# LAN address used in the development certificate and the storage backend's
# browser CORS allowlist. Set this before rotating certificates when serving
# the Astro app over HTTPS.
# M8_LAN_IP=192.168.1.36

# ── PostgreSQL superuser (engine bootstrap) ───────────────────────────────────
# Used by the postgres container itself + init-db.sh to create per-service users.
# Do not use these credentials in auth.env / api.env — services get their own users.
DB_USER=m8_admin
DB_PASSWORD=changethis
DB_PORT=5432

# ── DB isolation: choose ONE model, comment out the others ───────────────────
#
# SCENARIO 1 — single shared database
#   All services share one DB and one user. Simplest setup; no data isolation.
#
# DB_USER=myuser
# DB_PASSWORD=changethis
# DB_NAME=myapp
#
# SCENARIO 2 — per-service isolation (default for this stack)
#   init-db.sh creates a separate DB + user per service on first volume init.
#   Prefix rules: UPPERCASE, starts with a letter, chars [A-Z0-9_].
#   Each *_DB_PASSWORD is validated by the consuming service: >= 8 chars, with
#   upper, lower, digit, and special char (no spaces).
#
# Distinct per-service DB users, e.g. `auth_user` and `media_user`.
AUTH_DB_USER=changethis
AUTH_DB_PASSWORD=changethis
AUTH_DB_NAME=auth_db

MEDIA_DB_USER=changethis
MEDIA_DB_PASSWORD=changethis
MEDIA_DB_NAME=media_db

# prompt_engine_service DB. Values must match DB_USER / DB_PASSWORD / DB_DATABASE
# in prompt.env (that service connects with the generic DB_* names).
PROMPT_DB_USER=changethis
PROMPT_DB_PASSWORD=changethis
PROMPT_DB_NAME=prompt_engine_db

# reparto_service DB. Values must match DB_USER / DB_PASSWORD / DB_DATABASE in
# reparto.env (that service connects with the generic DB_* names).
REPARTO_DB_USER=changethis
REPARTO_DB_PASSWORD=changethis
REPARTO_DB_NAME=reparto_db
#
# SCENARIO 3 — arbitrary N-service isolation
#   Add any PREFIX_DB_{USER,PASSWORD,NAME} triplet. No compose edits needed.
#
# WORKER_DB_USER=worker_user
# WORKER_DB_PASSWORD=changethis
# WORKER_DB_NAME=worker_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Passwords: >= 8 chars, with upper, lower, digit, and special char (no spaces).
REDIS_PASSWORD=changethis
MEDIA_REDIS_PASSWORD=changethis

# ── Object storage (S3) ───────────────────────────────────────────────────────
# Admin identity for the storage backend. It is read ONLY by the two storage
# one-shots (storage-config, storage-init) and lands in the backend's own
# identity table — it is never placed in media.env / worker.env and is never
# handed to an application container. The apps authenticate as the scoped
# `media-rw` identity (S3_ACCESS_KEY / S3_SECRET_KEY in media.env), which can
# reach the five media buckets and nothing else.
# Access key >= 3 chars; secret >= 8 chars. Must differ from S3_ACCESS_KEY.
S3_ROOT_USER=changethis
S3_ROOT_PASSWORD=changethis

# Browser origin(s) allowed to call the storage endpoint directly. This stack
# is same-origin (the UI, API and storage backend all sit behind one Traefik
# host), so the origin list mirrors the site origins. Comma-separate to allow
# more than one. NEVER `*`.
#
# NOTE: env_file values are NOT shell-expanded, so M8_LAN_IP cannot be
# interpolated here the way it is in the compose file's own `environment:`
# block — storage-init's compose definition sets S3_CORS_ALLOW_ORIGIN directly
# (overriding this file) so the LAN origin still resolves. Edit it there, not
# here, when M8_LAN_IP changes.
S3_CORS_ALLOW_ORIGIN=http://localhost:4321,http://localhost:5173,http://localhost:9000

# ── Secrets & CI ──────────────────────────────────────────────────────────────
# .env must be fully written BEFORE 'docker compose up' on first boot.
# init-db.sh runs once at volume creation — changes to .env do not reprovision.
# To reprovision after config changes: bash init.sh --reset-db
#
# CI integration tests (clean state between runs):
#   bash init.sh --reset-db --yes && docker compose up -d --build
