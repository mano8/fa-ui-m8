# Copy to media.env.production — media_service PRODUCTION configuration.
#
# Mounted by the production overlay (docker-compose.production.yml) in place of
# the dev media.env. Token verification uses JWKS — no private key needed.
# Every secret is the literal `changethis` so the stack FAILS CLOSED until filled.

# ── Identity ──────────────────────────────────────────────────────────────────
# Hostname this stack is served on (localhost, an IPv4 or a domain).
DOMAIN=media.example.com
# local | development | staging | production - selects the SDK's security
# posture.
ENVIRONMENT=production
# Turn production-risk warnings into startup failures (default false).
STRICT_PRODUCTION_MODE=true
# Project identifier shown in API docs and logs (letters, digits, _ and -).
PROJECT_NAME=M8MediaService
# Stack slug used in names and logs (lowercase letters, digits and -).
STACK_NAME=m8-media-service

# ── API & docs (off in production) ────────────────────────────────────────────
# Route prefix the service is mounted under behind Traefik (path chars only,
# e.g. /user).
API_PREFIX=/media
# Serve the OpenAPI schema (true | false).
SET_OPEN_API=false
# Serve Swagger UI (true | false).
SET_DOCS=false
# Serve ReDoc (true | false).
SET_REDOC=false

# ── Host allowlist (fatal under strict if empty) ──────────────────────────────
# Comma-separated Host header allowlist (e.g. example.com,www.example.com);
# required in production.
ALLOWED_HOSTS=media.example.com

# ── CORS / Frontend (no localhost origins in production) ───────────────────────
# Public base URL of this backend (scheme://host[:port]).
BACKEND_HOST=https://media.example.com
# Public URL of the frontend (scheme://host[:port]); used in links the backend
# emits.
FRONTEND_HOST=https://app.example.com
# Comma-separated browser origins allowed by CORS, each scheme://host[:port]
# with no path.
BACKEND_CORS_ORIGINS=https://app.example.com

# ── Session cookie ─────────────────────────────────────────────────────────────
# Secure flag on the session cookie (default true; false only for plain-http
# local dev).
SESSION_COOKIE_SECURE=true

# ── Service role & auth routing ───────────────────────────────────────────────
# issuer (mints tokens, holds keys) or consumer (only validates tokens; must
# not hold private keys).
AUTH_SERVICE_ROLE=consumer
# Sub-prefix of the auth routes a fastapi-m8 consumer mounts (default /auth).
AUTH_PREFIX=/user

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# DB_USER must match MEDIA_DB_USER in .env; DB_PASSWORD must match MEDIA_DB_PASSWORD.
SELECTED_DB=Postgres
DB_HOST=m8_db
DB_PORT=5432
DB_DATABASE=media_db
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
DB_USER=changethis_media_user
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
DB_PASSWORD=changethis

# ── Media Redis (queues / rate limits / locks / presign cache) ────────────────
# Hostname of the media Redis (job queue and rate limits).
MEDIA_REDIS_HOST=media_redis_cache
# Media Redis port (1-65535, default 6379).
MEDIA_REDIS_PORT=6379
# Media Redis ACL user (default media).
MEDIA_REDIS_USER=media
# Password of MEDIA_REDIS_USER on the media Redis ACL.
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_REDIS_PASSWORD=changethis
# Key prefix for media keys in Redis (default media).
MEDIA_REDIS_NAMESPACE=media

# ── Internal service auth ─────────────────────────────────────────────────────
# Shared bearer token the media-worker presents on internal callbacks. Must match
# the worker's MEDIA_INTERNAL_SERVICE_TOKEN (worker.env).
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_INTERNAL_SERVICE_TOKEN=changethis

# ── Share links ───────────────────────────────────────────────────────────────
# Independent HMAC key for signing share-link tokens — media-service-owned, NOT an
# auth secret. In production this MUST come from secrets management. Rotating it
# invalidates every outstanding share link.
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_SHARE_SIGNING_SECRET=changethis
MEDIA_SHARE_DEFAULT_EXPIRES_SECONDS=604800
MEDIA_SHARE_MAX_EXPIRES_SECONDS=2592000

# ── S3 (internal-only — no host ports in the hardened stack) ──────────────────
# S3 endpoint as host[:port] (no scheme; TLS is S3_USE_SSL).
S3_ENDPOINT=storage:8333
# Use HTTPS to reach S3_ENDPOINT (true | false).
S3_USE_SSL=false
# S3 region name sent in SigV4 signatures (any value the backend accepts).
S3_REGION=eu-west-1
# Use `media_rw_user` as the access key (the scoped media-rw user, not root).
# Value: the storage backend enforces no format; use 20+ chars, letters and
#   digits only (AWS-style access key id).
S3_ACCESS_KEY=changethis
# Value: the storage backend enforces no format; use 40+ chars, letters and
#   digits only (AWS-style secret key).
S3_SECRET_KEY=changethis
S3_BUCKET_PUBLIC=public-media
S3_BUCKET_PRIVATE=private-media
S3_BUCKET_SENSITIVE=sensitive-media
S3_BUCKET_TEMP=temp-media
S3_BUCKET_ARCHIVE=archive-media
S3_PRESIGNED_URL_EXPIRE_SECONDS=300
# Browser-facing S3 endpoint for presigned GET/POST URLs (Option A browser-direct).
# Must differ from S3_ENDPOINT whenever the browser cannot resolve the internal hostname.
# The storage Traefik router (traefik/production_dynamic_conf.yml) terminates TLS and proxies to storage:8333.
# passHostHeader: true on that backend keeps the Host header intact for SigV4 GET signatures.
# Replace storage.example.com with your real storage FQDN (must match the Traefik Host rule).
S3_PUBLIC_ENDPOINT=https://storage.example.com
MEDIA_MAX_UPLOAD_SIZE_BYTES=104857600

# ── Lifecycle / retention (service-owned maintenance worker) ──────────────────
# Days a soft-deleted object is kept before hard deletion (>= 1, default 30).
MEDIA_RETENTION_PURGE_DAYS=30
# Max soft-deleted objects hard-purged per run (>= 1, default 500).
MEDIA_PURGE_BATCH_LIMIT=500
# Objects younger than this are skipped by the reconciler (>= 0, default 60).
MEDIA_RECONCILE_GRACE_MINUTES=60
# Max objects the orphan reconciler checks per run (>= 1, default 1000).
MEDIA_RECONCILE_BATCH_LIMIT=1000
# Hour of day (0-23) the daily hard-purge runs (default 3).
MEDIA_PURGE_CRON_HOUR=3
# Minute of the hour (0-59) the stale-upload expiry runs (default 15).
MEDIA_STALE_CRON_MINUTE=15

# ── Token verification — RS256 via JWKS ──────────────────────────────────────
# Access-token algorithm: RS256 (default, asymmetric via JWKS) or HS256
# (shared ACCESS_SECRET_KEY).
ACCESS_TOKEN_ALGORITHM=RS256
# Issuer JWKS URL the consumer fetches RS256 public keys from.
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
# Seconds the consumer caches the issuer's JWKS document (default 300).
JWKS_CACHE_TTL_SECONDS=300
# HS256 refresh-token key (refresh tokens are always HS256); required even on
# consumers.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
REFRESH_SECRET_KEY=changethis
# Must be HS256 (SDK-enforced).
REFRESH_TOKEN_ALGORITHM=HS256
# stateless (pure JWT) | hybrid (refresh JTIs in Redis) | stateful (Redis
# blacklist + DB sessions); must match the issuer.
TOKEN_MODE=stateful
# Access-token lifetime in minutes (SDK default 30); keep it short and equal
# across issuer and consumers.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in minutes (SDK default 120).
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Internal service-to-service HTTP (single trusted Docker host) ──────────────
# JWKS_URI / INTROSPECTION_URL reach auth_user_service over the Docker network on
# http://. Under strict production this is FATAL unless explicitly allowed. On a
# single trusted Docker host this is acceptable; multi-host deployments should use
# TLS/mTLS between services instead (see plan items 1.3 / 9.2).
ALLOW_INTERNAL_HTTP=true

# ── Token boundary claims — must match the issuer exactly (fatal under strict) ──
TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=https://auth.example.com
TOKEN_AUDIENCE=https://media.example.com

# ── Token revocation (stateful consumer) ─────────────────────────────────────
# Issuer private introspection endpoint the consumer calls for revocation
# checks.
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
# Must match PRIVATE_API_SECRET in auth.env.production.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
PRIVATE_API_SECRET=changethis

# ── Auth degradation policy (fail closed) ─────────────────────────────────────
# true forces every Redis-dependent security control to fail_closed (503) when
# Redis is down.
AUTH_STRICT_MODE=true
# When the revocation check cannot reach Redis/the issuer: fail_closed
# (reject, default) or fail_open (allow, logged).
ACCESS_REVOCATION_FAILURE_MODE=fail_closed
#REFRESH_VALIDATION_FAILURE_MODE=fail_closed
#SESSION_WRITE_FAILURE_MODE=fail_closed

# ── Event signing — must match auth.env.production ────────────────────────────
# Sign/verify auth events with EVENT_SIGNING_KEY (default true; boot fails
# without the key).
EVENT_SIGNING_ENABLED=true
# HMAC key for auth event signing; identical in the issuer and every consumer.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
EVENT_SIGNING_KEY=changethis

# ── Auth event stream (best-effort cache eviction) ────────────────────────────
# Seconds a positive introspection result is cached (>= 0; 0 = no cache,
# default).
REVOCATION_CACHE_TTL_SECONDS=30

# ── Observability ─────────────────────────────────────────────────────────────
# Expose Prometheus /metrics (default false).
METRICS_ENABLED=true
# Comma list of metric groups: all | traffic, performance, reliability,
# health, auth.
METRICS_GROUPS=all
# /metrics is internal-only by default; set a scrape credential only if metrics
# must cross a less-trusted boundary.
#METRICS_SCRAPE_CREDENTIAL=changethis

# ── Response security headers (opt-in HSTS even in production) ─────────────────
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
