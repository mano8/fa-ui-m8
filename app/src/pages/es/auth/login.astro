---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LoginPageApp from '@/components/auth/LoginPageApp';
import { getTranslations } from '@/content/i18n/app';

const t = getTranslations('es');
---

<StarlightPage frontmatter={{
  title: t.pages.loginTitle,
  tableOfContents: false
}}>
  <LoginPageApp client:only="react" locale="es" />
  <p class="text-xs text-center text-muted-foreground mt-4">
    {t.auth.login.newUser} <a href="/es/auth/signup" class="text-primary hover:underline font-medium">{t.auth.login.createAccount}</a>
  </p>
</StarlightPage>
