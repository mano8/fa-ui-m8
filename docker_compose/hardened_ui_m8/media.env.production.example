# Copy to media.env.production — media_service PRODUCTION configuration.
#
# Mounted by the production overlay (docker-compose.production.yml) in place of
# the dev media.env. Token verification uses JWKS — no private key needed.
# Every secret is the literal `changethis` so the stack FAILS CLOSED until filled.

# ── Identity ──────────────────────────────────────────────────────────────────
DOMAIN=media.example.com
ENVIRONMENT=production
STRICT_PRODUCTION_MODE=true
PROJECT_NAME=M8MediaService
STACK_NAME=m8-media-service

# ── API & docs (off in production) ────────────────────────────────────────────
API_PREFIX=/media
SET_OPEN_API=false
SET_DOCS=false
SET_REDOC=false

# ── Host allowlist (fatal under strict if empty) ──────────────────────────────
ALLOWED_HOSTS=media.example.com

# ── CORS / Frontend (no localhost origins in production) ───────────────────────
BACKEND_HOST=https://media.example.com
FRONTEND_HOST=https://app.example.com
BACKEND_CORS_ORIGINS=https://app.example.com

# ── Session cookie ─────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=true

# ── Service role & auth routing ───────────────────────────────────────────────
AUTH_SERVICE_ROLE=consumer
AUTH_PREFIX=/user

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# DB_USER must match MEDIA_DB_USER in .env; DB_PASSWORD must match MEDIA_DB_PASSWORD.
SELECTED_DB=Postgres
DB_HOST=m8_db
DB_PORT=5432
DB_DATABASE=media_db
DB_USER=changethis_media_user
DB_PASSWORD=changethis

# ── Media Redis (queues / rate limits / locks / presign cache) ────────────────
MEDIA_REDIS_HOST=media_redis_cache
MEDIA_REDIS_PORT=6379
MEDIA_REDIS_USER=media
MEDIA_REDIS_PASSWORD=changethis
MEDIA_REDIS_NAMESPACE=media

# ── Internal service auth ─────────────────────────────────────────────────────
# Shared bearer token the media-worker presents on internal callbacks. Must match
# the worker's MEDIA_INTERNAL_SERVICE_TOKEN (worker.env).
MEDIA_INTERNAL_SERVICE_TOKEN=changethis

# ── Share links ───────────────────────────────────────────────────────────────
# Independent HMAC key for signing share-link tokens — media-service-owned, NOT an
# auth secret. In production this MUST come from secrets management. Rotating it
# invalidates every outstanding share link.
MEDIA_SHARE_SIGNING_SECRET=changethis
MEDIA_SHARE_DEFAULT_EXPIRES_SECONDS=604800
MEDIA_SHARE_MAX_EXPIRES_SECONDS=2592000

# ── MinIO (internal-only — no host ports in the hardened stack) ───────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=eu-west-1
# Use `media_rw_user` as the access key (the scoped media-rw user, not root).
MINIO_ACCESS_KEY=changethis
MINIO_SECRET_KEY=changethis
MINIO_BUCKET_PUBLIC=public-media
MINIO_BUCKET_PRIVATE=private-media
MINIO_BUCKET_SENSITIVE=sensitive-media
MINIO_BUCKET_TEMP=temp-media
MINIO_BUCKET_ARCHIVE=archive-media
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=300
# Browser-facing MinIO endpoint for presigned GET/POST URLs (Option A browser-direct).
# Must differ from MINIO_HOST whenever the browser cannot resolve the internal hostname.
# The storage Traefik router (traefik/production_dynamic_conf.yml) terminates TLS and proxies to minio:9000.
# passHostHeader: true on that backend keeps the Host header intact for SigV4 GET signatures.
# Replace storage.example.com with your real storage FQDN (must match the Traefik Host rule).
MINIO_PUBLIC_ENDPOINT=https://storage.example.com
MEDIA_MAX_UPLOAD_SIZE_BYTES=104857600

# ── Lifecycle / retention (service-owned maintenance worker) ──────────────────
MEDIA_RETENTION_PURGE_DAYS=30
MEDIA_PURGE_BATCH_LIMIT=500
MEDIA_RECONCILE_GRACE_MINUTES=60
MEDIA_RECONCILE_BATCH_LIMIT=1000
MEDIA_PURGE_CRON_HOUR=3
MEDIA_STALE_CRON_MINUTE=15

# ── Token verification — RS256 via JWKS ──────────────────────────────────────
ACCESS_TOKEN_ALGORITHM=RS256
JWKS_URI=http://auth_user_service:8000/user/.well-known/jwks.json
JWKS_CACHE_TTL_SECONDS=300
REFRESH_SECRET_KEY=changethis
REFRESH_TOKEN_ALGORITHM=HS256
TOKEN_MODE=stateful
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Internal service-to-service HTTP (single trusted Docker host) ──────────────
# JWKS_URI / INTROSPECTION_URL reach auth_user_service over the Docker network on
# http://. Under strict production this is FATAL unless explicitly allowed. On a
# single trusted Docker host this is acceptable; multi-host deployments should use
# TLS/mTLS between services instead (see plan items 1.3 / 9.2).
ALLOW_INTERNAL_HTTP=true

# ── Token boundary claims — must match the issuer exactly (fatal under strict) ──
TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=https://auth.example.com
TOKEN_AUDIENCE=https://media.example.com

# ── Token revocation (stateful consumer) ─────────────────────────────────────
INTROSPECTION_URL=http://auth_user_service:8000/user/private/v1/jti-status
# Must match PRIVATE_API_SECRET in auth.env.production.
PRIVATE_API_SECRET=changethis

# ── Auth degradation policy (fail closed) ─────────────────────────────────────
AUTH_STRICT_MODE=true
ACCESS_REVOCATION_FAILURE_MODE=fail_closed
#REFRESH_VALIDATION_FAILURE_MODE=fail_closed
#SESSION_WRITE_FAILURE_MODE=fail_closed

# ── Event signing — must match auth.env.production ────────────────────────────
EVENT_SIGNING_ENABLED=true
EVENT_SIGNING_KEY=changethis

# ── Auth event stream (best-effort cache eviction) ────────────────────────────
REVOCATION_CACHE_TTL_SECONDS=30

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_GROUPS=all
# /metrics is internal-only by default; set a scrape credential only if metrics
# must cross a less-trusted boundary.
#METRICS_SCRAPE_CREDENTIAL=changethis

# ── Response security headers (opt-in HSTS even in production) ─────────────────
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
