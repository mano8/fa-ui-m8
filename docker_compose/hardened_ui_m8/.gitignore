
prometheus/data/*
grafana/data/*
db_data/*
mysql_db/*
db/*
redis/*
media_redis/*
minio/data/*
seaweedfs/data/*
# Generated by storage-config from .env + media.env — carries the storage admin
# and media-rw credentials verbatim. Never commit it.
seaweedfs/config/s3.json
# Minted at boot by storage-tls-init; s3.key is the S3 gRPC server's
# private key. seaweedfs/security.toml points at these and IS tracked.
seaweedfs/tls/
traefik/certs/*.pem
traefik/certs/*.crt
traefik/certs/*.key
*.pem
*README_DEV*
*.env
# Real runtime production env files hold secrets (the *.env.production.example
# templates are tracked; the filled-in *.env.production copies must never be).
*.env.production
# RSA signing key-pairs generated by init.sh — local-only, never committed
keys/
# Shared DB migrations mounted at runtime — generated, not repo-owned
shared_migrations/