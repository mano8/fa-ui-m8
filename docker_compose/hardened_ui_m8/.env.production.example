# Copy to .env — Docker Compose infrastructure variables (PRODUCTION).
#
# Compose auto-loads `.env`, so the production overlay reads this file once it is
# copied to `.env`. Application settings live in auth.env.production /
# media.env.production. Generate passwords:
#   python -c "import secrets,string; a=string.ascii_letters+string.digits; print('Aa1-'+''.join(secrets.choice(a) for _ in range(44)))"
#
# Every secret below is the literal `changethis` so the stack FAILS CLOSED until
# you fill it in.

# ── Traefik port binding ─────────────────────────────────────────────────────
# NOTE: the production overlay publishes only :80 (HTTP→HTTPS redirect) and :443,
# and does NOT host-publish the internal :9000 entryPoint or the DB/Redis/
# Prometheus/Grafana ports. API_BIND_IP is therefore unused under the overlay —
# kept here only for the dev base. It must NEVER be 0.0.0.0 in production
# (preflight blocks API_BIND_IP=0.0.0.0 when ENVIRONMENT=production).
#API_BIND_IP=127.0.0.1

# ── PostgreSQL superuser (engine bootstrap) ───────────────────────────────────
# Used by the postgres container + init-db.sh to create per-service users.
DB_USER=m8_admin
# Value: not validated by the services; use 16+ chars (32 recommended), no
#   max; letters, digits and - _ . ~ only.
DB_PASSWORD=changethis
DB_PORT=5432

# ── Per-service DB isolation (separate DB + user per service) ─────────────────
# Role init-db.sh creates for auth_user_service; must equal DB_USER in
# auth.env.
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
AUTH_DB_USER=changethis_auth_user
# Password of AUTH_DB_USER; must equal DB_PASSWORD in auth.env.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
AUTH_DB_PASSWORD=changethis
# Database init-db.sh creates for auth_user_service; must equal DB_DATABASE in
# auth.env.
AUTH_DB_NAME=auth_db

# Role init-db.sh creates for media_service; must equal DB_USER in media.env.
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
MEDIA_DB_USER=changethis_media_user
# Password of MEDIA_DB_USER; must equal DB_PASSWORD in media.env.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
MEDIA_DB_PASSWORD=changethis
# Database init-db.sh creates for media_service; must equal DB_DATABASE in
# media.env.
MEDIA_DB_NAME=media_db

# ── Redis (auth + media own separate instances) ──────────────────────────────
# Redis ACL password; must equal REDIS_PASSWORD in every service env file of
# this stack.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
REDIS_PASSWORD=changethis
# Password of MEDIA_REDIS_USER on the media Redis ACL.
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_REDIS_PASSWORD=changethis

# ── Object storage (S3, internal-only in the hardened stack — no host ports) ──
# Admin identity for the storage backend — read ONLY by storage-config /
# storage-init and the backend's own identity table, never by an application
# container. Must differ from S3_ACCESS_KEY (set in media.env.production).
S3_ROOT_USER=changethis_storage_admin
# Value: not validated by the services; use 16+ chars (32 recommended), no
#   max; letters, digits and - _ . ~ only.
S3_ROOT_PASSWORD=changethis

# Browser origin allowed to call the storage endpoint directly. Comma-separate
# to allow more than one. NEVER `*`.
S3_CORS_ALLOW_ORIGIN=https://ui.example.com

# ── Static UI (fa-ui-m8) ─────────────────────────
# Baked into the static build at `docker compose build` time -- REQUIRED
# for correct sitemap/canonical URLs. Replace with the real production FQDN
# used by the ui-router Host() rule in traefik/production_dynamic_conf.yml.
PUBLIC_SITE_URL=https://ui.example.com

# Tag this deployment's UI artifact is built and published under. PUBLIC_*
# build args are baked into the static HTML, so this build is NOT interchangeable
# with the base stack's auth-only localhost build -- give it its own tag and
# never re-push a changed build over an existing one. Bump the version component
# with app/package.json.
UI_IMAGE=tepochtli/fa-ui-m8:0.1.0-production
