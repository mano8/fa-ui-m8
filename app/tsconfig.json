      ],
      "@mano8/astro-media-m8/react": [
        "./src/lib/media-stubs/react.tsx"
      ],
      "@mano8/astro-media-m8/schemas": [
        "./src/lib/media-stubs/schemas.ts"
      ],
      "@mano8/astro-prompt-m8": [
        "./src/lib/prompt-stubs/integration.ts"
      ],
