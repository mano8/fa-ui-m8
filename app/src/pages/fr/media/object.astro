---
// src/pages/fr/media/object.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaObjectApp from '@/components/media/MediaObjectApp';
import { getTranslations } from '@/content/i18n/app';

const t = getTranslations('fr');
---

<StarlightPage frontmatter={{
  title: t.pages.mediaObjectTitle,
  tableOfContents: false
}}>
  <MediaObjectApp client:only="react">
    <div slot="fallback" class="mx-auto w-full max-w-4xl space-y-4 py-6 animate-pulse">
      <div class="h-4 w-32 rounded bg-muted/40"></div>
      <div class="h-72 rounded-xl border bg-muted/20"></div>
    </div>
  </MediaObjectApp>
</StarlightPage>
