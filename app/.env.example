# .env.example

# --- Auth Integration ---

# Base path for the backend auth service.
# - If running via Docker/Traefik: "/user" (proxied to auth service).
# - If running Astro dev standalone: "http://localhost:8000/user" (requires backend CORS).
PUBLIC_AUTH_API_BASE=/user

# Optional Google OAuth redirect target.
# By default, the UI only shows Google login for non-HTTP(S) native redirects,
# matching the current fa-auth-m8 google-api default. If your running stack
# permits HTTP(S) OAuth redirect targets, set PUBLIC_AUTH_GOOGLE_ENABLED=true.
# PUBLIC_AUTH_GOOGLE_ENABLED=true
# PUBLIC_AUTH_OAUTH_REDIRECT=chrome-extension://your-extension-id/auth/callback

# UI-layer chrome-extension redirect allowlist (plan item 8.2).
# Comma-separated list of exact extension-origin prefixes the UI will accept as
# a redirect target. If PUBLIC_AUTH_OAUTH_REDIRECT is a chrome-extension:// URL,
# it MUST start with one of these prefixes or Google login is suppressed (fail-closed).
# In production, pin to the exact extension ID(s); never leave blank when using
# a chrome-extension redirect (mirrors OAUTH_ALLOWED_REDIRECT_PREFIXES in auth.env).
# Must also be set in auth.env (backend enforces the same constraint server-side).
# PUBLIC_AUTH_OAUTH_ALLOWED_REDIRECT_PREFIXES=chrome-extension://your-extension-id/

# --- Media Integration (OPT-IN) ---

# Media is an OPT-IN plugin. The base configuration ships auth-only. Enabling it
# is a deployment-level choice = (1) install the package + (2) set the env below:
#   1. install:  npm install @fa-m8/astro-media-m8   (an optionalDependency)
#   2. configure: set PUBLIC_MEDIA_API_BASE (this var is the on/off gate — when
#      it is unset, astro.config.mjs does not load the media integration at all).
# For a static build the gate is read at BUILD time, so the var must be present
# when `astro build` runs (e.g. via the compose service `environment:` block).
#
# Canonical, operator-facing prefix is PUBLIC_MEDIA_* (set these). The media
# integration re-exposes them internally as PUBLIC_FA_MEDIA_* at build time; do
# not set the PUBLIC_FA_MEDIA_* names directly — they are an implementation detail.
#
# Base path for the backend media service (media-service-m8).
# - If running via Docker/Traefik: "/media" (proxied to media service).
# - If running Astro dev standalone: "http://localhost:8001/media" (requires backend CORS).
# PUBLIC_MEDIA_API_BASE=/media

# Sub-prefix for the versioned media routes (uploads/objects/variants/...).
# PUBLIC_MEDIA_V1_BASE=/v1
