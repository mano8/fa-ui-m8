# Copy to auth.env.production — auth_user_service PRODUCTION configuration.
#
# Used by the production overlay (docker-compose.production.yml), which mounts
# this file as the service's .env in place of the dev auth.env:
#   docker compose -f docker-compose.yml -f docker-compose.production.yml up -d
#
# Every secret below is the literal `changethis` so the stack FAILS CLOSED until
# you fill it in. Generate secret keys (32+ chars, upper, lower, digit,
# non-alphanumeric):
#   python -c "import secrets,string; a=string.ascii_letters+string.digits; print('Aa1-'+''.join(secrets.choice(a) for _ in range(44)))"
# In production prefer file-mounted secrets over plaintext here: any FIELD can be
# sourced from FIELD_FILE (e.g. PRIVATE_API_SECRET_FILE=/run/secrets/private_api).

# ── Identity ──────────────────────────────────────────────────────────────────
# Hostname this stack is served on (localhost, an IPv4 or a domain).
DOMAIN=auth.example.com
# local | development | staging | production - selects the SDK's security
# posture.
ENVIRONMENT=production
# Make every production safety check fatal (fail closed) rather than warn.
STRICT_PRODUCTION_MODE=true
PROJECT_NAME=MyAuthService
STACK_NAME=my-auth-service

# ── API & docs ────────────────────────────────────────────────────────────────
# Route prefix the service is mounted under behind Traefik (path chars only,
# e.g. /user).
API_PREFIX=/user
# Docs OFF in production. Flip SERVE_DOCS_IN_PRODUCTION=true only for a public,
# open-source API (emits a startup warning); never for a private deployment.
SET_OPEN_API=false
SET_DOCS=false
SET_REDOC=false
#SERVE_DOCS_IN_PRODUCTION=false

# ── Host allowlist (app-layer guard — fatal under strict if empty) ─────────────
# TrustedHostMiddleware rejects any Host header not listed here. Must include the
# public FQDN(s) this service answers on. Keep in sync with the Traefik Host(...)
# rule in traefik/production_dynamic_conf.yml.
ALLOWED_HOSTS=auth.example.com

# ── CORS / Frontend (no localhost origins in production) ───────────────────────
# Public base URL of this backend (scheme://host[:port]).
BACKEND_HOST=https://auth.example.com
# Public URL of the frontend (scheme://host[:port]); used in links the backend
# emits.
FRONTEND_HOST=https://app.example.com
# Comma-separated browser origins allowed by CORS, each scheme://host[:port]
# with no path.
BACKEND_CORS_ORIGINS=https://app.example.com

# ── Session cookie ─────────────────────────────────────────────────────────────
# HTTPS-only stack → cookies must be Secure.
SESSION_COOKIE_SECURE=true

# ── Service role ──────────────────────────────────────────────────────────────
# issuer (mints tokens, holds keys) or consumer (only validates tokens; must
# not hold private keys).
AUTH_SERVICE_ROLE=issuer

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# DB_USER must match AUTH_DB_USER in .env; DB_PASSWORD must match AUTH_DB_PASSWORD.
SELECTED_DB=Postgres
DB_HOST=m8_db
DB_PORT=5432
DB_DATABASE=auth_db
# Value: PostgreSQL role name - letters, digits and _, starting with a letter;
#   max 63 chars.
DB_USER=changethis_auth_user
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
DB_PASSWORD=changethis

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis hostname (compose service name).
REDIS_HOST=redis_cache
# Redis port (1-65535, default 6379).
REDIS_PORT=6379
# Redis ACL user name.
REDIS_USER=auth
# Password of REDIS_USER; identical in the Redis ACL and every client.
# Value: min 8 chars (32 recommended), no max; mix upper, lower, digit and a
#   symbol (- _ . ~); no spaces, $, #, quotes or backslash.
REDIS_PASSWORD=changethis

# ── RS256 asymmetric signing — keys volume-mounted from ./keys:/opt/keys:ro ──
ACCESS_TOKEN_ALGORITHM=RS256
REFRESH_TOKEN_ALGORITHM=HS256
ACCESS_PRIVATE_KEY_FILE=/opt/keys/private.pem
ACCESS_PUBLIC_KEY_FILE=/opt/keys/public.pem
ACCESS_KEY_ID=changethis_hex_kid
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
REFRESH_SECRET_KEY=changethis
#REFRESH_SECRET_KEY_OLD=
TOKEN_MODE=stateful
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Token boundary claims — REQUIRED (fatal under strict) ─────────────────────
# Real, public, stable values — the issuer/audience your consumers verify.
TOKEN_STRICT_VALIDATION=true
TOKEN_ISSUER=https://auth.example.com
TOKEN_AUDIENCE=https://media.example.com

# ── Auth-service-only secrets ─────────────────────────────────────────────────
# E-mail of the bootstrap superuser created on first start.
FIRST_SUPERUSER=admin@example.com
# Password of FIRST_SUPERUSER.
# Value: 8-72 chars (bcrypt caps passwords at 72 bytes); mix upper, lower,
#   digit and a symbol (- _ . ~); no spaces, $, #, quotes or backslash.
FIRST_SUPERUSER_PASSWORD=changethis
# Bootstrap secret for private-API calls; the consumer's value must match its
# entry in the issuer's PRIVATE_API_CONSUMERS.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
PRIVATE_API_SECRET=changethis
# Signs the OAuth/session state cookie; unique, never reused elsewhere.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
SESSION_SECRET=changethis
# Encrypts the tokens the issuer stores at rest (Fernet key derived from it);
# rotate via TOKENS_ENCRYPTION_KEY_OLD.
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
TOKENS_ENCRYPTION_KEY=changethis

# ── Event signing (fail-closed when enabled) ──────────────────────────────────
# Use the same EVENT_SIGNING_KEY here and in media.env.production.
EVENT_SIGNING_ENABLED=true
# Value: min 32 chars, no max; mix upper, lower, digit and a symbol (- _ . ~);
#   no spaces, $, #, quotes or backslash.
EVENT_SIGNING_KEY=changethis
# Accepting unsigned events is FATAL under production/strict — leave unset/false.
#EVENT_SIGNING_ACCEPT_UNSIGNED=false

# ── Hardened degradation policy (fail closed) ─────────────────────────────────
# true forces every Redis-dependent security control to fail_closed (503) when
# Redis is down.
AUTH_STRICT_MODE=true
# Rate limiter when Redis fails: fail_open (default) or fail_closed (503).
RATE_LIMIT_FAILURE_MODE=fail_closed
# When the revocation check cannot reach Redis/the issuer: fail_closed
# (reject, default) or fail_open (allow, logged).
ACCESS_REVOCATION_FAILURE_MODE=fail_closed
#REFRESH_VALIDATION_FAILURE_MODE=fail_closed
#SESSION_WRITE_FAILURE_MODE=fail_closed

# ── Proxy trust ───────────────────────────────────────────────────────────────
# One Traefik instance in front of this service.
TRUSTED_PROXY_COUNT=1

# ── Observability ─────────────────────────────────────────────────────────────
# Expose Prometheus /metrics (default false).
METRICS_ENABLED=true
# Comma list of metric groups: all | traffic, performance, reliability,
# health, auth.
METRICS_GROUPS=all
# /metrics is internal-only by default (network boundary is the control). Set a
# scrape credential ONLY if metrics must cross a less-trusted boundary; scrapers
# then send `Authorization: Bearer <credential>`.
#METRICS_SCRAPE_CREDENTIAL=changethis

# ── Chrome extension / native-app OAuth (optional) ────────────────────────────
# In production, pin redirects to exact extension IDs (do not leave open).
#OAUTH_ALLOWED_REDIRECT_PREFIXES=chrome-extension://abc123def456.../

# ── Response security headers ─────────────────────────────────────────────────
# HSTS is browser-persisted and hard to reverse — opt-in even in production.
# Enable only once TLS is stable on a trusted, stable certificate.
#HSTS_ENABLED=false
#CONTENT_SECURITY_POLICY_ENABLED=false
#HSTS_MAX_AGE=31536000
#HSTS_INCLUDE_SUBDOMAINS=true
#CONTENT_SECURITY_POLICY=
