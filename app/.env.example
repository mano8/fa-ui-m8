# .env.example

# --- Auth Integration ---

# Base path for the backend auth service.
# - If running via Docker/Traefik: "/user" (proxied to auth service).
# - If running Astro dev standalone: "http://localhost:8000/user" (requires backend CORS).
PUBLIC_AUTH_API_BASE=/user

# Optional Google OAuth redirect target.
# When absent, the UI uses the current page origin as the callback (same-origin),
# which is always accepted without further configuration.
# When set to an absolute override URL, the following rules apply (mirrors backend policy):
#   https://    Must start with an entry in PUBLIC_AUTH_OAUTH_ALLOWED_REDIRECT_PREFIXES.
#   http://     Accepted only for localhost / 127.0.0.1 (dev-only).
#   chrome-extension://  Must start with an entry in PUBLIC_AUTH_OAUTH_ALLOWED_REDIRECT_PREFIXES.
# Backend validation remains authoritative; this is an early-warning gate.
# PUBLIC_AUTH_GOOGLE_ENABLED=true
# PUBLIC_AUTH_OAUTH_REDIRECT=chrome-extension://your-extension-id/auth/callback

# UI-layer OAuth redirect allowlist.
# Comma-separated list of URL prefixes the UI will accept as an absolute override
# redirect target (PUBLIC_AUTH_OAUTH_REDIRECT). Required for https:// and
# chrome-extension:// overrides; omit for same-origin or localhost dev.
# Pin to exact origins/extension IDs in production; never leave blank when using
# an https:// or chrome-extension:// override (fail-closed).
# Must also be set in auth.env (backend enforces the same constraint server-side).
# PUBLIC_AUTH_OAUTH_ALLOWED_REDIRECT_PREFIXES=chrome-extension://your-extension-id/

# --- Media Integration (OPT-IN) ---

# Media is an OPT-IN plugin. The base configuration ships auth-only. Enabling it
# is a deployment-level choice = (1) install the package + (2) set the env below:
#   1. install:  npm install @mano8/astro-media-m8   (an optionalDependency)
#   2. configure: set PUBLIC_MEDIA_API_BASE (this var is the on/off gate — when
#      it is unset, astro.config.mjs does not load the media integration at all).
# For a static build the gate is read at BUILD time, so the var must be present
# when `astro build` runs (e.g. via the compose service `environment:` block).
#
# Canonical, operator-facing prefix is PUBLIC_MEDIA_* (set these). The media
# integration re-exposes them internally as PUBLIC_FA_MEDIA_* at build time; do
# not set the PUBLIC_FA_MEDIA_* names directly — they are an implementation detail.
#
# Base path for the backend media service (media-service-m8).
# - If running via Docker/Traefik: "/media" (proxied to media service).
# - If running Astro dev standalone: "http://localhost:8001/media" (requires backend CORS).
# PUBLIC_MEDIA_API_BASE=/media

# Sub-prefix for the versioned media routes (uploads/objects/variants/...).
# PUBLIC_MEDIA_V1_BASE=/v1

# Browser-direct storage origin for presigned uploads (CSP connect-src).
# Set to the public-facing scheme://host[:port] of the MinIO / object-storage
# endpoint that the browser POSTs to for direct uploads (i.e. the value of
# MINIO_PUBLIC_ENDPOINT in the media stack). When set, this origin is included
# in the production connect-src alongside the API origins. Leave unset for
# same-origin storage or local/home-lab deployments where the storage origin
# is already covered by 'self'.
# PUBLIC_MEDIA_STORAGE_ORIGIN=https://storage.example.com

# --- Prompt Integration (OPT-IN) ---

# Prompt is an OPT-IN plugin, mirroring the media pattern. Enable it as a
# deployment-level choice = (1) install the package + (2) set the env below:
#   1. install:  npm install @mano8/astro-prompt-m8   (an optionalDependency)
#   2. configure: set PUBLIC_PROMPT_API_BASE (this var is the on/off gate — when
#      it is unset, astro.config.mjs does not load the prompt integration).
# For a static build the gate is read at BUILD time, so the var must be present
# when `astro build` runs.
#
# Base path for the backend prompt service (prompt-engine-m8).
# - If running via Docker/Traefik: "/prompt" (proxied to prompt service).
# - If running Astro dev standalone: "http://localhost:9000/prompt" (requires backend CORS).
# PUBLIC_PROMPT_API_BASE=/prompt

# Optional API sub-prefix for prompt. Leave unset for the current contract:
# prompt-engine-m8 serves its routes directly below PUBLIC_PROMPT_API_BASE.
# PUBLIC_PROMPT_API_PREFIX=

# Minimum role that unlocks the prompt admin surface. Defaults to "admin",
# matching the require_admin floor prompt-engine-m8 enforces on /dashboard/*:
# any M8 role at or above it passes (superadmin, admin), and an explicit
# is_superuser flag always does. Set "is_superuser" to keep the older,
# superuser-only gate, or any other string for an exact-match custom role.
# PUBLIC_PROMPT_ADMIN_ROLE=admin

# --- Reparto Docente Integration (OPT-IN) ---

# Reparto is an OPT-IN plugin, mirroring the media/prompt pattern. Enable it as
# a deployment-level choice = (1) install the package + (2) set the env below:
#   1. install:  npm install @mano8/astro-reparto-m8   (an optionalDependency)
#   2. configure: set PUBLIC_REPARTO_API_BASE (this var is the on/off gate -
#      when it is unset, astro.config.mjs does not load the Reparto integration).
# For a static build the gate is read at BUILD time, so the var must be present
# when `astro build` runs.
#
# Base path for reparto-docente-m8.
# - If running via Docker/Traefik: "/reparto" (proxied to reparto_service).
# - If running Astro dev standalone against the dev_local_full_ui_m8 stack:
#   "http://localhost:9000/reparto" (requires backend CORS — that stack's
#   reparto.env already allows http://localhost:4321).
# PUBLIC_REPARTO_API_BASE=/reparto

# Optional API sub-prefix. Leave unset for the current reparto-docente-m8
# contract, where routes live directly below PUBLIC_REPARTO_API_BASE.
# PUBLIC_REPARTO_API_PREFIX=
