---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaObjectApp from './MediaObjectApp';
import { getTranslations, type Locale } from '@/content/i18n/app';
import '../../styles/media.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<StarlightPage frontmatter={{
  title: t.pages.mediaObjectTitle,
  tableOfContents: false
}}>
  <MediaObjectApp client:only="react">
    <div slot="fallback" class="mx-auto w-full max-w-6xl space-y-4 py-6 animate-pulse">
      <div class="h-4 w-32 rounded bg-muted/40"></div>
      <div class="h-72 rounded-xl border bg-muted/20"></div>
    </div>
  </MediaObjectApp>
</StarlightPage>
