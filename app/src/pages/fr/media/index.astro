---
// src/pages/fr/media/index.astro
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaApp from '@/components/media/MediaApp';
import { getTranslations } from '@/content/i18n/app';

const t = getTranslations('fr');
---

<StarlightPage frontmatter={{
  title: t.pages.mediaTitle,
  tableOfContents: false
}}>
  <MediaApp client:only="react">
    <div slot="fallback" class="w-full space-y-6 py-6 animate-pulse">
      <div class="space-y-2 border-b pb-6">
        <div class="h-8 w-48 rounded bg-muted/60"></div>
        <div class="h-4 w-72 rounded bg-muted/40"></div>
      </div>
      <div class="h-12 rounded-xl border bg-muted/20"></div>
      <div class="h-64 rounded-xl border bg-muted/20"></div>
    </div>
  </MediaApp>
</StarlightPage>
