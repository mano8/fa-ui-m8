      ],
      "@mano8/astro-reparto-m8/react": [
        "./src/lib/reparto-stubs/react.tsx"
      ],
      "@mano8/astro-reparto-m8/routes": [
        "./src/lib/reparto-stubs/routes.ts"
      ],
      "@mano8/astro-reparto-m8/schemas": [
        "./src/lib/reparto-stubs/schemas.ts"
